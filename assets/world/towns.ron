// El mundo y sus pueblos. Ver README.md en esta carpeta para cada campo. Editar
// y reiniciar, sin necesidad de recompilar. El jugador empieza en el primer
// pueblo; los otros aparecen a medida que cabalga hacia ellos.
(
    world: (
        // 8.4 km del centro a cada borde: un mundo de 16.8 km x 16.8 km, el más
        // grande permitido. Espacio para la línea del ferrocarril a escala 1:7.
        half_extent: 8400.0,
        // El suelo se construye en chunks cuadrados de 200 m alrededor del
        // jinete.
        chunk_size: 200.0,
    ),
    towns: [
        (
            // El jugador empieza aquí, donde comienza el primer encargo. Unos
            // 12.6 km al este y 5.4 km al norte de Castex, a escala 1:7.
            name: "Monte Nievas",
            origin: (-2450.0, -1950.0),
            blocks: (4, 3),
            block_size: 40.0,
            street_width: 12.0,
            railway: Some((side: North, offset: 24.0)),
            plaza: Auto,
            seed: 7,
            // Aquí no hay comisaría: Don Hidalgo manda al jugador a Castex.
            police_stations: Some(0),
            // Seis décimos de los 16 de un pueblo pequeño, para cuidar el
            // presupuesto del frame.
            townsfolk: Some(10),
        ),
        (
            // Un pequeño pueblo ferroviario inspirado en el Eduardo Castex de
            // 1920–1930, La Pampa. La plaza da a la estación, al otro lado de
            // la calle.
            name: "Eduardo Castex",
            origin: (-4250.0, -2721.0),
            blocks: (5, 4),
            block_size: 40.0,
            street_width: 12.0,
            railway: Some((side: North, offset: 24.0)),
            plaza: Auto,
            seed: 2,
            townsfolk: Some(10),
        ),
        (
            // Un apeadero del ferrocarril entre Monte Nievas y General Pico
            // (estación de 1906): unas pocas casas alrededor de un almacén. En
            // su lugar real, -35.774, -63.941: 16.63 km al oeste y 12.56 km al
            // sur de la plaza de Pico, a escala 1:7.
            name: "Metileo",
            origin: (288.0, -544.0),
            blocks: (3, 3),
            block_size: 40.0,
            street_width: 12.0,
            railway: Some((side: North, offset: 24.0)),
            plaza: Auto,
            seed: 19,
            police_stations: Some(0),
            // Solo alrededor de un tercio de los lotes están construidos: una
            // aldea, no un pueblo.
            density: Some(0.3),
            townsfolk: Some(10),
        ),
        (
            // Un pueblo muy grande (8 x 8 manzanas): una plaza de 2 x 2, una
            // plaza de la estación, y un almacén de ramos generales y una
            // comisaría a cada lado de la línea. Unos 35.8 km al este y 22.4 km
            // al norte de Monte Nievas, a escala 1:7. El Ferrocarril Oeste pasa
            // por el centro del pueblo, como en el Pico real, que creció a
            // ambos lados de él; la estación está en la mitad norte y la plaza,
            // unas cuadras al noroeste de ella. (La cuadrícula real está girada
            // 45°, a lo largo de la línea; aquí está alineada con el mapa, con
            // la línea sobre su eje este-oeste).
            name: "General Pico",
            origin: (2664.0, 1250.0),
            blocks: (8, 8),
            block_size: 40.0,
            street_width: 13.0,
            railway: Some((side: North, offset: 24.0, through: true)),
            plaza: Auto,
            seed: 13,
            // Seis décimos de los 51 que le tocarían por sus 64 manzanas.
            townsfolk: Some(31),
        ),
        (
            // Un pueblo ferroviario joven (fundado el 29 de octubre de 1911)
            // sobre el ramal Metileo–Arizona, 41 km al noroeste de Castex:
            // 3.38 km al oeste y 4.82 km al norte de él a escala 1:7, 774 m
            // hacia adentro del borde oeste del mundo. Una plaza, una
            // comisaría, una pulpería y casas en alrededor de dos tercios de
            // sus lotes; el ramal termina en su estación.
            name: "Caleufú",
            origin: (-7626.0, 2100.0),
            blocks: (4, 4),
            block_size: 40.0,
            street_width: 12.0,
            railway: Some((side: North, offset: 24.0)),
            plaza: Auto,
            seed: 23,
            density: Some(0.6),
            townsfolk: Some(10),
        ),
    ],
    // La línea del ferrocarril, en orden: tramos que se doblan en curvas
    // amplias unen la vía de cada pueblo con la del siguiente. Todo pueblo con
    // ferrocarril debe estar en la lista.
    line: Some(["Eduardo Castex", "Monte Nievas", "Metileo", "General Pico"]),
    // Ramales de la línea: un pueblo de empalme sobre ella y luego los pueblos
    // hasta los que llega el ramal. El ramal Metileo–Arizona sale del extremo
    // oeste de Metileo, por donde sale la línea hacia Monte Nievas, y se curva
    // hacia el noroeste hasta Caleufú.
    branches: [["Metileo", "Caleufú"]],
    // Lagunas de agua dulce poco profundas, hundidas en la pampa con un
    // cinturón de juncos.
    lagoons: [
        (
            // 5.9 km reales con rumbo de 119° desde General Pico (5.16 km al
            // este, 2.86 km al sur), a escala 1:7. Unas 150 ha en la realidad:
            // se conserva su forma, con 215 x 145 m. Su centro está 3 m al este
            // de ese lugar, para que los alambrados de la mensura no toquen su
            // orilla junto a las calles más anchas de Pico (S6c).
            name: "Laguna La Arocena",
            center: (3404.0, 841.0),
            size: (215.0, 145.0),
            seed: 5,
        ),
    ],
)
