// The world and its towns. See README.md in this folder for every field.
// Edit and restart, no recompiling needed. The player starts at the first
// town; the others appear as you ride towards them.
(
    world: (
        // 8.4 km from the center to each edge: a 16.8 km x 16.8 km world,
        // the largest allowed. Room for the railway line at a 1:7 scale.
        half_extent: 8400.0,
        // Ground is built in 200 m square chunks around the rider.
        chunk_size: 200.0,
    ),
    towns: [
        (
            // The player starts here, where the first errand begins. About
            // 12.6 km east and 5.4 km north of Castex, scaled 1:7.
            name: "Monte Nievas",
            origin: (-2450.0, -1950.0),
            blocks: (4, 3),
            block_size: 40.0,
            street_width: 10.0,
            railway: Some((side: North, offset: 24.0)),
            plaza: Auto,
            seed: 7,
            // No comisaría here: Don Hidalgo sends the player to Castex.
            police_stations: Some(0),
            // Six tenths of a small town's 16, to spare the frame budget.
            townsfolk: Some(10),
        ),
        (
            // A small railway town inspired by 1920s–1930s Eduardo Castex,
            // La Pampa. The plaza faces the station across the street.
            name: "Eduardo Castex",
            origin: (-4250.0, -2721.0),
            blocks: (5, 4),
            block_size: 40.0,
            street_width: 10.0,
            railway: Some((side: North, offset: 24.0)),
            plaza: Auto,
            seed: 2,
            townsfolk: Some(10),
        ),
        (
            // A railway halt between Monte Nievas and General Pico (station
            // 1906): a few houses round a store. At its real place,
            // -35.774, -63.941: 16.63 km west and 12.56 km south of Pico's
            // plaza, scaled 1:7.
            name: "Metileo",
            origin: (288.0, -544.0),
            blocks: (3, 3),
            block_size: 30.0,
            street_width: 8.0,
            railway: Some((side: North, offset: 24.0)),
            plaza: Auto,
            seed: 19,
            police_stations: Some(0),
            // Only about a third of the lots are built: a village, not a town.
            density: Some(0.3),
            townsfolk: Some(10),
        ),
        (
            // A very big town (8 x 8 blocks): a 2 x 2 plaza, a station
            // plaza, and a general store and a police station on each side
            // of the line. About
            // 35.8 km east and 22.4 km north of Monte Nievas, scaled 1:7.
            // The Ferrocarril Oeste runs through the middle of town, as in
            // the real Pico, which grew on both sides of it; the station
            // stands in the north half, the plaza a few blocks north-west of
            // it. (The real grid is turned 45°, along the line; here it is
            // square to the map, the line along its east-west axis.)
            name: "General Pico",
            origin: (2664.0, 1250.0),
            blocks: (8, 8),
            block_size: 40.0,
            street_width: 10.0,
            railway: Some((side: North, offset: 24.0, through: true)),
            plaza: Auto,
            seed: 13,
            // Six tenths of the 51 its 64 blocks would get.
            townsfolk: Some(31),
        ),
        (
            // A young railway town (founded 29 October 1911) on the
            // Metileo–Arizona branch, 41 km north-west of Castex: 3.38 km
            // west and 4.82 km north of it at 1:7, 774 m inside the world's
            // west edge. A plaza, a comisaría, a pulpería and houses on
            // about two thirds of its lots; the branch ends at its station.
            name: "Caleufú",
            origin: (-7626.0, 2100.0),
            blocks: (4, 4),
            block_size: 40.0,
            street_width: 10.0,
            railway: Some((side: North, offset: 24.0)),
            plaza: Auto,
            seed: 23,
            density: Some(0.6),
            townsfolk: Some(10),
        ),
    ],
    // The railway line, in order: links that bend on wide curves join each
    // town's track to the next one's. Every town with a railway must be
    // listed.
    line: Some(["Eduardo Castex", "Monte Nievas", "Metileo", "General Pico"]),
    // Branches off the line: a junction town on it, then the towns the
    // branch runs out to. The Metileo–Arizona branch leaves Metileo's
    // west end, where the line to Monte Nievas does, and curves away
    // north-west to Caleufú.
    branches: [["Metileo", "Caleufú"]],
    // Shallow freshwater lagoons, sunk into the pampa with a reed belt.
    lagoons: [
        (
            // Real 5.9 km at bearing 119° from General Pico (5.16 km east,
            // 2.86 km south), scaled 1:7. About 150 ha in reality: its
            // shape is kept, at 215 x 145 m.
            name: "Laguna La Arocena",
            center: (3401.0, 841.0),
            size: (215.0, 145.0),
            seed: 5,
        ),
    ],
)
