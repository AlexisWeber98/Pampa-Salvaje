// The world and its towns. See README.md in this folder for every field.
// Edit and restart, no recompiling needed. The player starts at the first
// town; the others appear as you ride towards them.
(
    world: (
        // 4 km from the center to each edge: an 8 km x 8 km world.
        half_extent: 4000.0,
        // Ground is built in 200 m square chunks around the rider.
        chunk_size: 200.0,
    ),
    towns: [
        (
            // A small railway town inspired by 1920s–1930s Eduardo Castex,
            // La Pampa. The plaza faces the station across the street.
            name: "Eduardo Castex",
            origin: (0.0, 0.0),
            blocks: (4, 5),
            block_size: 40.0,
            street_width: 10.0,
            railway: Some((side: North, offset: 24.0)),
            plaza: Auto,
            seed: 7,
        ),
        (
            name: "Quilmes",
            origin: (-1500.0, 0.0),
            blocks: (7, 7),
            block_size: 40.0,
            street_width: 10.0,
            railway: Some((side: North, offset: 24.0)),
            plaza: Auto,
            seed: 3,
        ),
        (
            name: "Florencio Varela",
            origin: (1300.0, 0.0),
            blocks: (6, 4),
            block_size: 40.0,
            street_width: 10.0,
            railway: Some((side: North, offset: 24.0)),
            plaza: Auto,
            seed: 2,
        ),
    ],
)
