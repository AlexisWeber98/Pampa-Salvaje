// El primer encargo: Don Hidalgo, en la plaza de Monte Nievas, manda al jugador
// a ver al comisario Elías Farach en la comisaría de Castex. Ver README.md en
// esta carpeta para las reglas (caracteres, longitud).
(
    // Don Hidalgo, cuando el jugador le habla en la plaza. Una línea tras otra,
    // unos segundos cada una.
    hidalgo: [
        "¡Buenas! Usted es el que llegó en tren.",
        "Acá en Monte Nievas no hay comisaría.",
        "Preséntese en la comisaría de Castex.",
        "Lo espera el comisario Elías Farach.",
        "Llévese mi caballo, el del almacén.",
        "Castex queda al oeste, siguiendo la vía.",
    ],
    // El jugador, junto al caballo de Don Hidalgo antes de hablar con él.
    not_your_horse: [
        "Este caballo no es mío.",
    ],
    // El comisario Farach, cuando el jugador se presenta a su puerta.
    farach: [
        "¡Buenas! ¿Lo manda Don Hidalgo?",
        "Soy Elías Farach, el comisario.",
        "Bienvenido a Castex, paisano.",
        "Quédese cerca, que trabajo no falta.",
    ],
    // El pueblo a cuya comisaría el encargo envía al jugador, por su nombre en
    // world/towns.ron (el objetivo del HUD también lo nombra). Sin él, o cuando
    // ese pueblo no tiene comisaría, el otro pueblo más cercano que tenga una.
    police_town: "Eduardo Castex",
)
