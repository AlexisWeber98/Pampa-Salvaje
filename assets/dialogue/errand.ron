// The first errand: Don Hidalgo, in the Monte Nievas plaza, sends the
// player to comisario Elías Farach at the Castex comisaría.
// See README.md in this folder for the rules (characters, length).
(
    // Don Hidalgo, when the player talks to him in the plaza. One line
    // after the other, a few seconds each.
    hidalgo: [
        "¡Buenas! Usted es el que llegó en tren.",
        "Acá en Monte Nievas no hay comisaría.",
        "Preséntese en la comisaría de Castex.",
        "Lo espera el comisario Elías Farach.",
        "Llévese mi caballo, el del almacén.",
        "Castex queda al oeste, siguiendo la vía.",
    ],
    // The player, at Don Hidalgo's horse before talking to him.
    not_your_horse: [
        "Este caballo no es mío.",
    ],
    // Comisario Farach, when the player reports at his door.
    farach: [
        "¡Buenas! ¿Lo manda Don Hidalgo?",
        "Soy Elías Farach, el comisario.",
        "Bienvenido a Castex, paisano.",
        "Quédese cerca, que trabajo no falta.",
    ],
)
