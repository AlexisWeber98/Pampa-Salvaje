// Lo que dicen los vecinos cuando el jinete los choca. Ver README.md en esta
// carpeta para las reglas (caracteres, longitud).
(
    // Empujado al paso: molesto, pero sin exagerar.
    walk: [
        "¡Eh, mirá por dónde andás!",
        "¡Cuidado con el caballo, che!",
        "¡Epa! ¿No ve que hay gente?",
        "¡Despacito, paisano!",
        "¡Ojo con el pingo, don!",
        "¡Mire que no soy un poste!",
        "¡Che, que me pisa los pies!",
        "¿Y a usted quién lo apura?",
        "¡Pida permiso, amigo!",
        "¡Ay! ¡Mi alpargata!",
        "¡Qué vergüenza, empujar así!",
    ],
    // Atropellado al galope: asustado y enojado.
    gallop: [
        "¡Casi me pisa el pingo, che!",
        "¡Más despacio, que no es carrera!",
        "¡Bárbaro! ¡Me llenó de tierra!",
        "¡Bruto! ¡Casi me mata!",
        "¡Ave María! ¡Qué atropellado!",
        "¡Sujete ese caballo, por Dios!",
        "¡Esto no es una cuadrera!",
        "¡Voy a llamar al comisario!",
        "¡Mire que lo denuncio, eh!",
        "¡Pare, cristiano, pare!",
    ],
)
